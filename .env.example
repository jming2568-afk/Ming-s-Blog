# =========================================================================
# 博客项目环境变量模板（复制为 .env.local 使用；Vercel 部署配置在项目设置里）
# =========================================================================

# 管理员会话签名密钥（生产必设，缺失会报错"服务初始化失败：[auth]..."）
# 生成：openssl rand -hex 32
AUTH_SECRET=

# Vercel Blob 读写凭证（Storage → Blob 创建后复制；不配则本地降级写 data/content.local.json）
BLOB_READ_WRITE_TOKEN=

# 首次初始化的管理员账号（可选，默认 useradmin / useradmin123，登录后请在 /settings 修改密码）
# INIT_ADMIN_USERNAME=useradmin
# INIT_ADMIN_PASSWORD=useradmin123
