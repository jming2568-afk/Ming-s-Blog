# =========================================================================
# 博客项目环境变量模板（复制为 .env.local 使用；Vercel 部署配置在项目设置里）
# =========================================================================

# 管理后台会话签名密钥（生产必设，缺失会直接报错）
# 生成：openssl rand -hex 32
AUTH_SECRET=

# 管理后台登录密码（生产必设，缺失会直接报错；本地开发默认 admin123）
ADMIN_PASSWORD=

# Vercel Blob 读写凭证（Storage → Blob 创建后复制；不配则本地降级写 data/content.local.json）
BLOB_READ_WRITE_TOKEN=
