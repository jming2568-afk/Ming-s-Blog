    "bcryptjs": "^3.0.3",
    "docx": "^9.3.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.9.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
