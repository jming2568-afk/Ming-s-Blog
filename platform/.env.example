# V0.03 环境变量（TECH-001 低内存原生部署）
# 本地：cp .env.example .env 后按需修改；生产：写入 /opt/resume-platform/.env

# API
PORT=3000
# 数据库：SQLite（TECH-001，替代 PostgreSQL）
SQLITE_PATH=./data/resume.db
CORS_ORIGINS=http://localhost:5173

# P4：对象存储（阿里云 OSS，S3 兼容；本地开发可 MinIO）
# STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# STORAGE_REGION=oss-cn-hangzhou
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=resume-platform
# STORAGE_PUBLIC_URL_BASE=https://resume-platform.oss-cn-hangzhou.aliyuncs.com
# STORAGE_PATH_STYLE=false   # MinIO 设 true（path-style）；阿里 OSS 虚拟主机式 false（默认）

# P5：LLM（火山方舟；兼容 openai chat/completions 与 openai responses 两套协议，LLM_PROTOCOL=auto 自动回退）
# LLM_API_KEY=            # 与 ARK_API_KEY 二选一
# ARK_API_KEY=
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_TEXT_MODEL=deepseek-v4-flash-ga-260731
# LLM_VISION_MODEL=doubao-seed-2-0-lite-260428
# LLM_PROTOCOL=auto       # chat | responses | auto

# P5：管理端（逗号分隔的用户名自动提升为 admin）
# ADMIN_USERNAMES=

# 生产部署模板见 platform/deploy/（systemd + nginx + deploy.sh + backup.sh）
