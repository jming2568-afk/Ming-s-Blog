# V0.03 环境变量（配置中心版）
# 生产：只需 3~4 个「引导变量」写入 /opt/resume-platform/.env；
# 其余全部在管理面板（/admin → 平台控制面板）中实时配置，无需重启。

# ── 引导变量（必须在 .env，DB 启动前提）──
# SQLITE_PATH=            # 数据库文件（生产：/opt/resume-platform/data/resume.db）
# CONFIG_MASTER_KEY=      # 配置加密主密钥（openssl rand -hex 32），用于 AES-256-GCM 加密入库的密钥项
# PORT=3000
# NODE_ENV=production

# ── 可选引导 ──
# ADMIN_USERNAMES=        # 逗号分隔管理员用户名（也可在面板「平台」组里配置，env 仅作首次引导兜底）

# ── 以下均已改为面板管理（DB 存储，敏感值加密），无需写在这里 ──
# LLM_API_KEY / ARK_API_KEY、LLM_BASE_URL、LLM_TEXT_MODEL、LLM_VISION_MODEL、LLM_PROTOCOL
# STORAGE_ENDPOINT / REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY / BUCKET / PUBLIC_URL_BASE / PATH_STYLE
# CORS_ORIGINS

# 生产部署模板见 platform/deploy/（systemd + nginx + deploy.sh + backup.sh）
# 运维见 platform/docs/04-ops/OPS-001.md；架构见 platform/docs/03-tech/TECH-001.md
