# V0.03 本地开发 / 生产部署（Linux + Docker）
# 复制为 .env 后按需修改；生产环境务必改 POSTGRES_PASSWORD

# PostgreSQL
POSTGRES_PASSWORD=resume_dev_pw

# API
DATABASE_URL=postgres://resume:${POSTGRES_PASSWORD}@postgres:5432/resume
PORT=3000
CORS_ORIGINS=http://localhost:5173

# 本地直跑 API 时（不经 docker 网络）用：
# DATABASE_URL=postgres://resume:${POSTGRES_PASSWORD}@localhost:5432/resume

# P4：对象存储（TOS S3 兼容）
# STORAGE_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# STORAGE_REGION=cn-beijing
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=

# P5：LLM（火山方舟）
# ARK_API_KEY=
