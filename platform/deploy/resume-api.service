# Resume Platform API — systemd 单元（TECH-001 原生部署）
# 安装：sudo cp resume-api.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now resume-api

[Unit]
Description=Resume Platform API (Hono + SQLite)
After=network.target

[Service]
Type=simple
User=resume
Group=resume
WorkingDirectory=/opt/resume-platform/app/api
# 生产环境变量统一放 /opt/resume-platform/.env（STORAGE_*、ARK_API_KEY 等）
Environment=NODE_ENV=production
Environment=SQLITE_PATH=/opt/resume-platform/data/resume.db
EnvironmentFile=-/opt/resume-platform/.env
ExecStart=/usr/bin/node dist/index.cjs
Restart=always
RestartSec=3
# 日志
StandardOutput=append:/opt/resume-platform/logs/api.log
StandardError=append:/opt/resume-platform/logs/api.err.log
# 资源上限（TECH-001：4G swap 兜底，MemoryMax 防突发 OOM 拖垮整机）
LimitNOFILE=65535
MemoryMax=512M

[Install]
WantedBy=multi-user.target
